# Auto-managed plugin symlinks
plugins/enabled/

# Runtime state files
*.lock
.backup.*
.atomic-write.*.tmp
.sync.*

# Test artifacts
tests/tmp/
*.bats.log
artifacts/

# Editor and IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Claude Code configuration (user-specific)
# Allow settings.json, scripts/, commands/, and docs to be committed for project-wide automation
.claude/*
!.claude/settings.json
!.claude/scripts/
!.claude/commands/
!.claude/README.md
!.claude/HOOK_INTEGRATION_RESEARCH.md
!.claude/IMPLEMENTATION_PLAN.md

# Block user-specific Claude Code settings
.claude/settings.local.json

# Temporary files
*.tmp
tmp/
